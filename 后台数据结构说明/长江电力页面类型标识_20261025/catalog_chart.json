              "query": {
                "mode": "sql",
                "sql": "SELECT v.scenario_name, x.\"口径\", x.\"收益率（%）\" FROM vi_valuation v JOIN vi_model_base m ON m.id = v.model_id JOIN vi_company_base co ON co.id = m.company_id AND co.code = '600900.SH' JOIN vi_model_base m0 ON m0.id = m.id AND m0.status = '当前' CROSS JOIN LATERAL (VALUES ('隐含收益率', round((v.implied_irr * 100)::numeric, 2)), ('现金支持口径', round((v.cash_implied_irr * 100)::numeric, 2)), ('要求收益率', round((v.required_return * 100)::numeric, 2))) x(\"口径\", \"收益率（%）\") ORDER BY v.sort, 2"
              },
              "chart": {
                "option": {
                  "mode": "basic",
                  "builder": {
                    "type": "bar",
                    "xField": "scenario_name",
                    "yField": "收益率（%）",
                    "seriesField": "口径"
                  }
                }
              }
            }
